# Binaries
# Leading slash anchors these to the repo root so the compiled `corelaycode`/`proxy`
# binaries are ignored without also ignoring the cmd/proxy/ source directory.
*.exe
*.exe~
/corelaycode
/corelaycode-acp
/corelaycode-profile
# Legacy binary name retained so local pre-rename builds stay ignored.
/aniclew
/proxy
dist/

# Dependencies
web/node_modules/
web/bun.lock

# Build
web/dist/

# Config (user-specific)
config.json

# Private data (conversations, memory, sessions) at the project root only.
# Leading slash anchors these to the repo root so subpackages like
# internal/memory/ or web/memory.tsx are NOT accidentally ignored.
/MEMORY.md
/memory/
/conversations/
/sessions/
/.corelay/
# Legacy state directory retained to avoid exposing local migration data.
/.aniclew/
/.termsnap/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
# test
